################################################################################
# Sophus install dir
get_filename_component(Sophus_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)

################################################################################
set( Sophus_INCLUDE_DIR  "${Sophus_CMAKE_DIR}/../../../include" )
set( Sophus_INCLUDE_DIRS  "${Sophus_INCLUDE_DIR}" )

set( Sophus_LIBRARIES    "${Sophus_CMAKE_DIR}/../../../lib/libSophus.so" )
set( Sophus_LIBRARY      "${Sophus_LIBRARIES}" )

set( Sophus_LIBRARY_DIR  "${Sophus_CMAKE_DIR}/../../../lib" )
set( Sophus_LIBRARY_DIRS "${Sophus_LIBRARY_DIR}" )
